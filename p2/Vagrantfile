Vagrant.configure("2") do |config|
  config.vm.box              = "perk/ubuntu-2204-arm64"
  config.vm.box_check_update = false

  config.trigger.before :up do |trigger|
    trigger.info = "Clearing port 50022..."
    trigger.run = { inline: "bash -c 'lsof -ti:50022 | xargs kill -9 2>/dev/null || true; sleep 3'" }
  end

  config.trigger.after :up do |trigger|
    trigger.info = "Setting up 0.0.0.0:80 -> VM:80 via SSH tunnel..."
    trigger.ruby do |env, machine|
      key = machine.data_dir.join("private_key").to_s

      system("sudo ifconfig lo0 alias 192.168.56.110 255.255.255.255 2>/dev/null; true")
      system("sudo pkill -f 'ssh.*:80:localhost:80' 2>/dev/null; true")
      sleep 1

      system(
        "sudo", "ssh", "-fNT",
        "-L", "0.0.0.0:80:localhost:80",
        "-p", "50022",
        "-i", key,
        "-o", "StrictHostKeyChecking=no",
        "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR",
        "vagrant@127.0.0.1"
      )
      puts "    ediabS: Tunnel ready — curl -H 'Host: app1.com' http://192.168.56.110"
    end
  end

  config.trigger.before [:destroy, :halt] do |trigger|
    trigger.info = "Tearing down SSH tunnel and loopback alias..."
    trigger.ruby do |env, machine|
      system("sudo pkill -f 'ssh.*:80:localhost:80' 2>/dev/null; true")
      system("sudo ifconfig lo0 -alias 192.168.56.110 2>/dev/null; true")
    end
  end

  config.vm.define "ediabS" do |server|
    server.vm.hostname = "ediabS"

    server.vm.provider "qemu" do |qemu|
      qemu.arch       = "aarch64"
      qemu.machine    = "virt,accel=hvf,highmem=off"
      qemu.cpu        = "host"
      qemu.net_device = "virtio-net-pci"
      qemu.memory     = "2048"
      qemu.cpus       = 1
      qemu.ssh_port   = 50022
    end

    server.vm.provision "file", source: "confs", destination: "/tmp/confs"
    server.vm.provision "shell", path: "scripts/setup_server.sh"
  end
end